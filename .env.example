# --- Comportamiento ---
CACHE_ENABLED=true              # false para comparar latencias sin Redis
DISPATCH_INTERVAL_MS=20000      # reintento de la cola de espera de tickets
RATE_LIMIT_REPLENISH=20
RATE_LIMIT_BURST=40

# --- Puertos publicados ---
GATEWAY_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- Versiones de imágenes (fijadas; actualizar de forma controlada) ---
MYSQL_VERSION=8.4
REDIS_VERSION=7.4-alpine
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.0.0
